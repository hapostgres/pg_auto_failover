*		whitespace=space-before-tab,trailing-space
*.[chly]	whitespace=space-before-tab,trailing-space,indent-with-non-tab,tabwidth=4
*.dsl		whitespace=space-before-tab,trailing-space,tab-in-indent
*.patch		-whitespace
*.pl		whitespace=space-before-tab,trailing-space,tabwidth=4
*.po		whitespace=space-before-tab,trailing-space,tab-in-indent,-blank-at-eof
*.sgml		whitespace=space-before-tab,trailing-space,tab-in-indent,-blank-at-eol
*.x[ms]l	whitespace=space-before-tab,trailing-space,tab-in-indent

# Avoid confusing ASCII underlines with leftover merge conflict markers
README		conflict-marker-size=32
README.*	conflict-marker-size=32


# These files are maintained or generated elsewhere.  We take them as is.
configure				-whitespace

# all C files (implementation and header) use our style...
*.[ch] citus-style

# except these exceptions...
src/bin/lib/parson/** -citus-style
src/bin/lib/log/** -citus-style
src/bin/lib/libs/** -citus-style
src/bin/lib/pg/** -citus-style
src/bin/lib/subcommands.c/** -citus-style
src/monitor/version_compat.c -citus-style
# bison/flex generated files — not subject to style checks
src/bin/pgaftest/test_spec_parse.c -citus-style
src/bin/pgaftest/test_spec_parse.h -citus-style
src/bin/pgaftest/test_spec_scan.c  -citus-style
# vendored PostgreSQL source (pg_receivewal.c/receivelog.c/streamutil.c/
# walmethods.c, REL_17_STABLE, byte-for-byte except two marked "PGAF:"
# edits in pg_receivewal.c itself -- see that file's own header comment)
# -- kept as upstream formats it, not this project's own citus-style, so
# a future re-sync against a newer upstream diffs cleanly instead of
# fighting a wall of reindentation noise. pg_receivewal_entry.h is this
# project's own new file, not vendored, and stays citus-style checked.
src/bin/pg_autoctl/vendor/pg_receivewal/pg_receivewal.c -citus-style
src/bin/pg_autoctl/vendor/pg_receivewal/receivelog.c -citus-style
src/bin/pg_autoctl/vendor/pg_receivewal/receivelog.h -citus-style
src/bin/pg_autoctl/vendor/pg_receivewal/streamutil.c -citus-style
src/bin/pg_autoctl/vendor/pg_receivewal/streamutil.h -citus-style
src/bin/pg_autoctl/vendor/pg_receivewal/walmethods.c -citus-style
src/bin/pg_autoctl/vendor/pg_receivewal/walmethods.h -citus-style
