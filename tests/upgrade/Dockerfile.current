# pgaf:current — v2.2 with both binaries baked in, linked via pgaf/current.
#
# Layout:
#   /usr/local/bin/pg_autoctl              — symlink → pgaf/current/pg_autoctl
#   /usr/local/bin/pgaf/2.2/pg_autoctl     — v2.2 binary
#   /usr/local/bin/pgaf/2.3/pg_autoctl     — v2.3 binary (from pgaf:next)
#   /usr/local/bin/pgaf/current            — symlink → pgaf/2.2  (initially)
#
# "Injecting" an upgrade = ln -sfn /usr/local/bin/pgaf/2.3 /usr/local/bin/pgaf/current
# Run that inside each container via `docker compose exec`; no docker cp needed.
#
# How the self-restart mechanism works:
#
#   /usr/local/bin/pg_autoctl is a symlink that resolves through pgaf/current.
#   PG_AUTOCTL_DEBUG_BIN_PATH is set to that path so the v2.2 supervisor stores
#   /usr/local/bin/pg_autoctl as pg_autoctl_program.  When it spawns a child it
#   calls execv("/usr/local/bin/pg_autoctl", args) with args[0] also set to that
#   path, so the child's argv[0] is /usr/local/bin/pg_autoctl regardless of which
#   version the symlink chain resolves to.
#
#   The keeper uses argv[0] for the on-disk version check:
#
#       run_program(pg_autoctl_argv0, "version", "--json")
#
#   After the symlink flip, that call resolves through pgaf/current → pgaf/2.3
#   and returns required_extension_version "2.3".  With the monitor extension now
#   at "2.3" the keeper finds a match and calls exit(EXIT_CODE_MONITOR), causing
#   the v2.2 supervisor to re-exec the child from the v2.3 binary.
#
# v2.2 → v2.3 command compatibility:
#
#   v2.2 supervisor spawns services as "pg_autoctl do service {postgres,listener,
#   node-active}".  v2.3 renamed "do" to "internal" internally but retains "do"
#   as a hidden root command that routes to the same service callbacks, so no
#   translation layer is needed.
#
#   pgaftest generates "pg_autoctl create <kind> --run" for specs that declare
#   "legacy-startup" (as upgrade.pgaf does), matching what production v2.2
#   operators ran.  No shim or translation layer is needed.
#
#   The upgrade procedure restarts the monitor container (compose stop + start)
#   rather than just restarting postgres in-process.  This avoids a race where
#   the v2.2 listener reconnects to the freshly-restarted postgres at the same
#   moment data-node keepers do, producing transient "schema does not exist"
#   errors that exhaust the v2.2 supervisor restart limit.

ARG BASE_IMAGE=pgaf:current-base
ARG NEXT_IMAGE=pgaf:next

FROM ${NEXT_IMAGE} AS next
FROM ${BASE_IMAGE}

USER root

# Place both binaries side by side; current → 2.2 initially.
RUN mkdir -p /usr/local/bin/pgaf/2.2 /usr/local/bin/pgaf/2.3
RUN mv /usr/local/bin/pg_autoctl /usr/local/bin/pgaf/2.2/pg_autoctl
COPY --from=next /usr/local/bin/pg_autoctl /usr/local/bin/pgaf/2.3/pg_autoctl
RUN ln -s /usr/local/bin/pgaf/2.2 /usr/local/bin/pgaf/current \
    && ln -s /usr/local/bin/pgaf/current/pg_autoctl /usr/local/bin/pg_autoctl \
    && chown -R docker /usr/local/bin/pgaf

# Pre-stage v2.3 extension files so the upgrade step is a local install, not
# a docker cp from an external image.  Stored alongside the v2.3 binary.
ARG PGVERSION=16
COPY --from=next /usr/share/postgresql/${PGVERSION}/extension/pgautofailover.control \
                 /usr/local/bin/pgaf/2.3/pgautofailover.control
COPY --from=next /usr/share/postgresql/${PGVERSION}/extension/pgautofailover--2.2--2.3.sql \
                 /usr/local/bin/pgaf/2.3/pgautofailover--2.2--2.3.sql
COPY --from=next /usr/share/postgresql/${PGVERSION}/extension/pgautofailover--2.3.sql \
                 /usr/local/bin/pgaf/2.3/pgautofailover--2.3.sql
COPY --from=next /usr/lib/postgresql/${PGVERSION}/lib/pgautofailover.so \
                 /usr/local/bin/pgaf/2.3/pgautofailover.so

# Install script — uses pg_config at runtime so PGVERSION need not be baked in.
# Usage (inside the container, as root):  /usr/local/bin/pgaf/2.3/install-extension
COPY install-extension.sh /usr/local/bin/pgaf/2.3/install-extension
RUN chmod 755 /usr/local/bin/pgaf/2.3/install-extension

# Tell the v2.2 supervisor to use the symlink path for spawning child processes,
# so that after the symlink flip the next child spawn picks up v2.3.
ENV PG_AUTOCTL_DEBUG_BIN_PATH=/usr/local/bin/pg_autoctl

USER docker
