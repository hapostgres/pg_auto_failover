# Upgrade test: live binary + extension swap without container restarts.
#
# Tests the documented production upgrade procedure:
#
#   1. Install new binary on ALL nodes while the cluster is running.
#      The keeper's FSM loop fires exit(EXIT_CODE_MONITOR) only when the
#      monitor extension version matches the NEW binary's required version,
#      so pre-staging the binary is safe and does not trigger self-restart yet.
#
#   2. Install new binary + new extension files on the monitor, then upgrade
#      the extension with ALTER EXTENSION pgautofailover UPDATE TO '<new>',
#      and restart the monitor container.  A full container restart (compose
#      stop + start) is used rather than just restarting postgres in-process:
#      without it the old .so stays resident in memory and keepers get a
#      "loaded library requires <old> but control file specifies <new>" error.
#
#   3. Each keeper's node-active child polls the monitor, sees the extension
#      version now matches the new binary's required version, and calls
#      exit(EXIT_CODE_MONITOR).  The supervisor re-execs the node-active child
#      from the new binary.  Postgres is never restarted on data nodes; only
#      the pg_autoctl child re-execs.
#
# Image build requirements — run before this spec:
#   make -C tests/upgrade pgaf-current   → pgaf:current  (built from previous tag)
#   make -C tests/upgrade pgaf-next      → pgaf:next     (built from current branch)
#
# pgaf:current contains BOTH binaries (prev and next) and the next extension
# files pre-staged at /usr/local/bin/pgaf/next/.  The "inject" steps below
# flip an in-container symlink and install those pre-staged files — no runtime
# dependency on pgaf:next once the images are built.
#
# PGVERSION defaults to 16.  Rebuild with
#   PGVERSION=17 make -C tests/upgrade pgaf-current pgaf-next
# if needed.
#
# Note on Postgres restart: the previous release (v2.1) contains a bug where
# keeper_pg_init_and_register calls keeper_ensure_node_has_been_dropped without
# first calling monitor_init, so the check connects to local Postgres instead of
# the monitor and fails with "schema pgautofailover does not exist".  The v2.1
# supervisor retries 5 times in rapid succession, then exits, which takes the
# container down.  The v2.2 binary fixes this (monitor_init is now called
# first).  The upgrade procedure therefore restarts each data-node container
# after the old supervisor dies; docker preserves the volume so Postgres data
# is intact, and Postgres itself restarts cleanly from its on-disk state.
# Future upgrades from v2.2 will not need this container restart because the
# v2.2 supervisor correctly re-execs the new binary without triggering the bug.

cluster {
    monitor
    image "pgaf:current"
    legacy-startup
    formation {
        node1
        node2
        node3
    }
}

setup {
    wait until node1 state is primary
        and node2 state is secondary
        and node3 state is secondary
        timeout 300s
}

teardown {
    compose down
}

# -------------------------------------------------------------------------
# Baseline: cluster running on pgaf:current (previous release).
# Write a marker row that must survive through the upgrade.
# -------------------------------------------------------------------------

step test_001_baseline {
    sql node1 { CREATE TABLE upgrade_marker(ts timestamptz default now()); }
    sql node1 { INSERT INTO upgrade_marker DEFAULT VALUES; }
    sql monitor {
        SELECT installed_version
        FROM pg_available_extensions
        WHERE name = 'pgautofailover';
    }
    expect { 2.1 }
}

# -------------------------------------------------------------------------
# Phase 1: flip the "current" symlink on data nodes to point at the next
# binary.  Both binaries are already baked into pgaf:current — no docker cp
# is needed.  The symlink at /usr/local/bin/pg_autoctl delegates to
# pgaf/current/pg_autoctl, so after the flip:
#   - The keeper's on-disk version check (argv0 version --json) returns "2.2"
#   - The previous supervisor's next child spawn also uses next binary
#     (via PG_AUTOCTL_DEBUG_BIN_PATH)
# No self-restart fires yet: the monitor extension is still at the previous
# version and the keeper only exits when installed matches on-disk required.
# -------------------------------------------------------------------------

step test_002_inject_node_binaries {
    exec node1  ln -sfn /usr/local/bin/pgaf/next /usr/local/bin/pgaf/current
    exec node2  ln -sfn /usr/local/bin/pgaf/next /usr/local/bin/pgaf/current
    exec node3  ln -sfn /usr/local/bin/pgaf/next /usr/local/bin/pgaf/current
}

# -------------------------------------------------------------------------
# Phase 2: install the next extension files on the monitor, restart the
# monitor container so postgres loads the next pgautofailover.so, flip the
# monitor symlink, then upgrade the extension catalog.
#
# The restart must happen BEFORE "ALTER EXTENSION ... UPDATE", not after:
# pgautofailover is loaded via shared_preload_libraries, so the running
# postmaster keeps the OLD .so mapped in memory even after install-extension
# overwrites the file on disk -- new backends forked from it still see the
# old, pre-restart library image. "ALTER EXTENSION ... UPDATE" validates
# every CREATE FUNCTION in the upgrade script by dlsym-ing that in-memory
# library; a function that exists only in the new .so (added by this branch,
# with no v2.1 equivalent) can't resolve there and CREATE FUNCTION fails with
# "could not find function ... in file ...". Existing, unchanged functions
# don't expose this because their symbols were already present pre-restart.
# Restarting first makes the new postmaster load the new .so (already on
# disk) via shared_preload_libraries, so the upgrade script's new symbols
# resolve normally.
#
# compose stop + start avoids a race where the previous listener reconnects
# to the freshly-restarted postgres at the same moment data-node keepers do,
# producing transient "schema pgautofailover does not exist" errors that
# exhaust the previous supervisor's restart limit.  A full container restart
# gives data nodes a clean "monitor is down, keep retrying" signal. The
# healthcheck (pg_autoctl status) makes "compose start" block until the
# pg_autoctl process itself reports running -- but that fires slightly
# before postgres finishes its own restart, so the ALTER EXTENSION call
# right after can still race "the database system is starting up".
# "pg_autoctl inspect pgsetup wait" closes that last, short window: it's
# the project's own native retry-with-timeout primitive for exactly this
# condition, rather than a hand-rolled shell polling loop.
# -------------------------------------------------------------------------

step test_003_upgrade_monitor {
    # Install next extension files into system paths.
    exec monitor  sudo /usr/local/bin/pgaf/next/install-extension
    # Flip the monitor symlink; from here pg_autoctl = next binary.
    exec monitor  ln -sfn /usr/local/bin/pgaf/next /usr/local/bin/pgaf/current
    compose stop monitor
    compose start monitor
    exec monitor  pg_autoctl inspect pgsetup wait --pgdata /var/lib/postgres/pgaf --read-write --timeout 30
    # Upgrade the extension catalog, now that the restarted postmaster has
    # the next pgautofailover.so loaded.
    exec monitor  psql -U docker -d pg_auto_failover -c "ALTER EXTENSION pgautofailover UPDATE TO '2.2'"
}

# -------------------------------------------------------------------------
# Phase 3: allow old keepers to exit, then restart containers with new binary.
#
# After the monitor extension becomes "2.2", the v2.1 node-active children
# compare the installed version against the on-disk binary's required version
# — they match, so each child calls exit(EXIT_CODE_MONITOR).  The v2.1
# supervisor then attempts to restart via keeper_pg_init_and_register, but
# hits a bug (no monitor_init before the dropped-node check) and fails 5
# times.  The supervisor gives up and exits, taking the container with it.
#
# We then restart the data-node containers.  The symlink already points at
# the next binary, so they start with v2.2 pg_autoctl.  The v2.2 binary
# handles the state-file restart path correctly (monitor_init is called first)
# and Postgres comes back up cleanly from its persisted on-disk state.
# -------------------------------------------------------------------------

step test_003b_wait_keeper_restart {
    # Wait for old node-active processes to detect the extension version
    # mismatch and exit with EXIT_CODE_MONITOR. The v2.1 supervisor then
    # tries to restart via keeper_pg_init_and_register, which fails 5 times
    # in rapid succession (v2.1 bug: no monitor_init before the dropped-node
    # check). The supervisor then gives up and exits, taking the container
    # with it. 20 s is ample time for this on any runner.
    exec monitor sleep 20

    # The data node containers are now Exited. Restart them; the symlink
    # already points at the next binary so these containers run v2.2.
    # The v2.2 keeper_pg_init_and_register calls monitor_init first and
    # handles the state-file path correctly. Postgres restarts cleanly from
    # its on-disk state (the v2.1 supervisor called pg_ctl stop before
    # exiting, so the data directory is consistent).
    compose start node1
    compose start node2
    compose start node3

    # Give the restarted keepers time to initialize and start reporting.
    exec monitor sleep 30
}

step test_004_wait_convergence {
    # 300s: 3-node post-upgrade reconvergence can be slow on shared CI runners.
    #
    # Role-agnostic on purpose: test_003b's container restart dance can leave
    # node1 down long enough (container stop + restart lag) to cross the
    # monitor's unhealthy/demote thresholds, triggering a genuine failover to
    # node2 before node1 comes back as a secondary. That's a legitimate FSM
    # outcome, not a bug -- so this only asserts the shape of convergence
    # (exactly one primary, the other two secondary), not which node ends up
    # primary.
    wait until primary, secondary, secondary in group 0 timeout 300s
}

# -------------------------------------------------------------------------
# Verify the upgrade mechanism actually fired on each node.
# -------------------------------------------------------------------------

step test_005_verify_node_restart {
    logs node1 contains "exiting for a restart of the node-active process"
    logs node2 contains "exiting for a restart of the node-active process"
    logs node3 contains "exiting for a restart of the node-active process"
}

step test_006_verify_extension_version {
    sql monitor {
        SELECT installed_version
        FROM pg_available_extensions
        WHERE name = 'pgautofailover';
    }
    expect { 2.2 }
}

# -------------------------------------------------------------------------
# Data integrity: row written before the upgrade must be readable on all
# nodes, confirming Postgres was never stopped on the data nodes.
# -------------------------------------------------------------------------

step test_007_verify_data_intact {
    # Role-agnostic for the same reason as test_004_wait_convergence: node1
    # may have lost the primary role to node2 during test_003b's restart.
    # The data-integrity checks below are already keyed by node name, not
    # role, so they don't need to change.
    wait until primary, secondary, secondary in group 0 timeout 120s
    sql node1 { SELECT count(*) FROM upgrade_marker; }
    expect { 1 }
    sql node2 { SELECT count(*) FROM upgrade_marker; }
    expect { 1 }
    sql node3 { SELECT count(*) FROM upgrade_marker; }
    expect { 1 }
}

# -------------------------------------------------------------------------
# Smoke: failover through the fully-upgraded cluster.
# -------------------------------------------------------------------------

step test_008_failover_post_upgrade {
    promote node2
    wait until node2 state is primary
        and node1 state is secondary
        and node3 state is secondary
        timeout 300s
}

step test_009_write_on_new_primary {
    sql node2 { INSERT INTO upgrade_marker DEFAULT VALUES; }
    sql node1 { SELECT count(*) FROM upgrade_marker; }
    expect { 2 }
    sql node3 { SELECT count(*) FROM upgrade_marker; }
    expect { 2 }
}
