# pg_walserver archive-cleanup (cli_archive_cleanup.c): WAL/base-backup
# retention. See README.md's own "archive-cleanup" section for the full
# design; this spec exercises it end to end against a route fed by the
# embedded receivewal worker ("receivewal = pull", pg_walserver setup's own
# default), so every WAL segment involved is real, captured off a real
# pg_auto_failover-managed primary (node1).
#
# This PR's own pgaftest predates `let`/`${var}` capture (see pg_walserver_
# standalone.pgaf's own header comment), so values that cross steps are
# written to a plain file on node2 and re-read with $(cat ...).
#
# "Old" backups (older than any --keep-age window this spec uses) are
# fabricated by cloning an already-taken, real backup directory under a
# label whose embedded timestamp is far in the past -- cli_archive_
# cleanup.c's own retention decision reads a backup's age from its
# directory *name* (cli_basebackup.c's "basebackup-<UTC timestamp>Z"
# scheme), never the directory's own mtime, so this is a faithful way to
# get a deterministic "old" backup without waiting real hours. Its cloned
# backup_label still names a real, still-present WAL segment, so it is
# never flagged "superseded" by mistake.
#
#   test_001  three real backups taken (one automatic at "serve" startup,
#             two more by hand between real WAL switches); --dry-run
#             reports the two oldest as removable under --keep-count 1
#             without touching anything
#   test_002  archive-cleanup refuses to run with neither --keep-count nor
#             --keep-age
#   test_003  a --keep-age value with no suffix is rejected with a clear
#             error
#   test_004  --keep-count 1 for real removes the two older backups and
#             leaves the latest one still genuinely restorable (a real
#             pg_basebackup against it succeeds afterward)
#   test_005  more-conservative-wins: two fabricated old backups survive
#             a combined --keep-count 3 --keep-age 1h dry run (count alone
#             already wants to keep all 3, so age's own wish to remove the
#             old ones is overruled), then are actually removed by
#             --keep-age 1h alone once --keep-count no longer protects them
#   test_006  a backup basebackups/.latest points at, and the WAL segment
#             it requires, survive an aggressive --keep-count 1 run even
#             though it is neither the most recent backup nor within the
#             count/age window that would otherwise keep it

cluster {
    monitor
    ssl off
    formation {
        node1 replication-password "pgaf-repl-pw"
        node2 replication-password "pgaf-repl-pw"
    }
}

setup {
    wait until primary, secondary in group 0  timeout 120s

    # same loopback-only HBA precedent as pg_walserver_standalone.pgaf's
    # own setup{}.
    exec node2 bash -c 'mkdir -p /tmp/ws && printf "host all all 127.0.0.1/32 trust\n" > /tmp/ws/pg_walserver_hba.conf'

    # "receivewal = pull" (setup's own default: no --receivewal/--no-receivewal
    # flag at all) so this route accumulates real WAL continuously, off
    # node1, with no manual archive-wal pushing needed anywhere in this
    # spec.
    exec node2 bash -c 'PGPASSWORD=pgaf-repl-pw pg_walserver setup --pgdata /tmp/ws --cluster default/0 --path /tmp/ws/default/0 --upstream "host=node1 port=5432 user=pgautofailover_replicator sslmode=disable"'

    sql node1 { CREATE TABLE ws(a int); INSERT INTO ws VALUES (1); }

    exec node2 bash -c 'nohup pg_walserver --pgdata /tmp/ws --port 6543 > /tmp/ws-walserver.log 2>&1 & echo started'
    exec node2 bash -c 'for i in $(seq 30); do (echo > /dev/tcp/127.0.0.1/6543) 2>/dev/null && exit 0; sleep 1; done; cat /tmp/ws-walserver.log; exit 1'

    # "serve" bootstraps this route's first base backup automatically,
    # once its embedded receivewal worker has real streaming evidence (see
    # README.md's "Bootstrapping a route's first base backup").
    exec node2 bash -c 'for i in $(seq 60); do grep -q "is now the latest for \"/tmp/ws/default/0\"" /tmp/ws-walserver.log && exit 0; sleep 1; done; cat /tmp/ws-walserver.log; exit 1'
    exec node2 bash -c 'cat /tmp/ws/default/0/basebackups/.latest > /tmp/backup_A0.label'
}

teardown {
    compose down
}

step test_001_three_backups_and_dry_run_reports_without_deleting {
    sql node1 { INSERT INTO ws SELECT generate_series(1, 10) }
    sql node1 { SELECT pg_switch_wal() }
    exec node2 bash -c 'sleep 3'
    exec node2 bash -c 'PGPASSWORD=pgaf-repl-pw pg_walserver basebackup --pgdata /tmp/ws --cluster default/0'
    exec node2 bash -c 'cat /tmp/ws/default/0/basebackups/.latest > /tmp/backup_A1.label'

    sql node1 { INSERT INTO ws SELECT generate_series(11, 20) }
    sql node1 { SELECT pg_switch_wal() }
    exec node2 bash -c 'sleep 3'
    exec node2 bash -c 'PGPASSWORD=pgaf-repl-pw pg_walserver basebackup --pgdata /tmp/ws --cluster default/0'
    exec node2 bash -c 'cat /tmp/ws/default/0/basebackups/.latest > /tmp/backup_A2.label'

    exec node2 bash -c 'test "$(cat /tmp/backup_A2.label)" != "$(cat /tmp/backup_A1.label)" || { echo "A1 and A2 collided"; false; }'
    exec node2 bash -c 'ls /tmp/ws/default/0/basebackups/ | grep -c "^basebackup-" | grep -qx 3 || { ls -la /tmp/ws/default/0/basebackups/; false; }'

    exec node2 bash -c 'PGPASSWORD=pgaf-repl-pw pg_walserver archive-cleanup --path /tmp/ws/default/0 --keep-count 1 --dry-run > /tmp/dryrun1.out 2>&1; cat /tmp/dryrun1.out'
    exec node2 bash -c 'grep -q "would remove backup \"/tmp/ws/default/0/basebackups/$(cat /tmp/backup_A0.label)\"" /tmp/dryrun1.out || { cat /tmp/dryrun1.out; false; }'
    exec node2 bash -c 'grep -q "would remove backup \"/tmp/ws/default/0/basebackups/$(cat /tmp/backup_A1.label)\"" /tmp/dryrun1.out || { cat /tmp/dryrun1.out; false; }'
    exec node2 bash -c 'grep -q "would remove backup \"/tmp/ws/default/0/basebackups/$(cat /tmp/backup_A2.label)\"" /tmp/dryrun1.out && { echo "dry run should not want to remove the latest backup"; false; } || true'

    # --dry-run really removed nothing.
    exec node2 bash -c 'ls /tmp/ws/default/0/basebackups/ | grep -c "^basebackup-" | grep -qx 3 || { ls -la /tmp/ws/default/0/basebackups/; false; }'
}

step test_002_refuses_to_run_with_neither_flag {
    exec node2 bash -c 'PGPASSWORD=pgaf-repl-pw pg_walserver archive-cleanup --path /tmp/ws/default/0; test $? -ne 0'
    exec node2 bash -c 'PGPASSWORD=pgaf-repl-pw pg_walserver archive-cleanup --path /tmp/ws/default/0 2>&1 | grep -q "requires --keep-count and/or --keep-age"'
    exec node2 bash -c 'ls /tmp/ws/default/0/basebackups/ | grep -c "^basebackup-" | grep -qx 3 || { ls -la /tmp/ws/default/0/basebackups/; false; }'
}

step test_003_bad_keep_age_value_is_rejected {
    exec node2 bash -c 'PGPASSWORD=pgaf-repl-pw pg_walserver archive-cleanup --path /tmp/ws/default/0 --keep-age 5; test $? -ne 0'
    exec node2 bash -c 'PGPASSWORD=pgaf-repl-pw pg_walserver archive-cleanup --path /tmp/ws/default/0 --keep-age 5 2>&1 | grep -q "expected a number followed by one of"'
    exec node2 bash -c 'PGPASSWORD=pgaf-repl-pw pg_walserver archive-cleanup --path /tmp/ws/default/0 --keep-age 5x; test $? -ne 0'
}

step test_004_keep_count_only_removes_older_backups_leaving_a_restorable_latest {
    exec node2 bash -c 'PGPASSWORD=pgaf-repl-pw pg_walserver archive-cleanup --path /tmp/ws/default/0 --keep-count 1'

    exec node2 bash -c 'test ! -d "/tmp/ws/default/0/basebackups/$(cat /tmp/backup_A0.label)" || { echo "A0 should have been removed"; false; }'
    exec node2 bash -c 'test ! -d "/tmp/ws/default/0/basebackups/$(cat /tmp/backup_A1.label)" || { echo "A1 should have been removed"; false; }'
    exec node2 bash -c 'test -d "/tmp/ws/default/0/basebackups/$(cat /tmp/backup_A2.label)" || { echo "A2 (the latest) should still be there"; false; }'
    exec node2 bash -c 'ls /tmp/ws/default/0/basebackups/ | grep -c "^basebackup-" | grep -qx 1 || { ls -la /tmp/ws/default/0/basebackups/; false; }'

    # the surviving "latest" backup is still genuinely restorable: a real,
    # unmodified pg_basebackup against it must still succeed.
    exec node2 bash -c 'PGPASSWORD=pgaf-repl-pw pg_basebackup -w -d "host=127.0.0.1 port=6543 dbname=default/0 user=pgautofailover_replicator replication=true sslmode=disable" -D /tmp/restored-after-cleanup -X none --no-manifest'
    exec node2 bash -c 'test -f /tmp/restored-after-cleanup/PG_VERSION'
}

step test_005_more_conservative_wins_between_count_and_age {
    # fabricate two "old" backups (their labels' own embedded timestamps
    # are years in the past) by cloning the one real backup that survived
    # test_004 -- same backup_label content, so they require exactly the
    # WAL segment that backup already needs, still present on disk.
    exec node2 bash -c 'cp -a "/tmp/ws/default/0/basebackups/$(cat /tmp/backup_A2.label)" /tmp/ws/default/0/basebackups/basebackup-19980101T000000Z'
    exec node2 bash -c 'cp -a "/tmp/ws/default/0/basebackups/$(cat /tmp/backup_A2.label)" /tmp/ws/default/0/basebackups/basebackup-19990101T000000Z'
    exec node2 bash -c 'ls /tmp/ws/default/0/basebackups/ | grep -c "^basebackup-" | grep -qx 3 || { ls -la /tmp/ws/default/0/basebackups/; false; }'

    # --keep-count 3 alone would already keep all three (there are only
    # three); combined with --keep-age 1h, the more conservative
    # (--keep-count, here) wins: age's own wish to remove the two 1998/
    # 1999-dated ones is overruled, nothing is removed.
    exec node2 bash -c 'PGPASSWORD=pgaf-repl-pw pg_walserver archive-cleanup --path /tmp/ws/default/0 --keep-count 3 --keep-age 1h --dry-run > /tmp/dryrun2.out 2>&1; cat /tmp/dryrun2.out'
    exec node2 bash -c 'grep -q "would remove backup" /tmp/dryrun2.out && { cat /tmp/dryrun2.out; false; } || true'
    exec node2 bash -c 'ls /tmp/ws/default/0/basebackups/ | grep -c "^basebackup-" | grep -qx 3 || { ls -la /tmp/ws/default/0/basebackups/; false; }'

    # --keep-age 1h alone, with no --keep-count to overrule it, does
    # remove the two 1998/1999-dated backups for real.
    exec node2 bash -c 'PGPASSWORD=pgaf-repl-pw pg_walserver archive-cleanup --path /tmp/ws/default/0 --keep-age 1h'
    exec node2 bash -c 'test ! -d /tmp/ws/default/0/basebackups/basebackup-19980101T000000Z || { echo "the 1998 backup should have been removed"; false; }'
    exec node2 bash -c 'test ! -d /tmp/ws/default/0/basebackups/basebackup-19990101T000000Z || { echo "the 1999 backup should have been removed"; false; }'
    exec node2 bash -c 'test -d "/tmp/ws/default/0/basebackups/$(cat /tmp/backup_A2.label)" || { echo "the real, recent backup should still be there"; false; }'
    exec node2 bash -c 'ls /tmp/ws/default/0/basebackups/ | grep -c "^basebackup-" | grep -qx 1 || { ls -la /tmp/ws/default/0/basebackups/; false; }'
}

step test_006_latest_backup_and_its_wal_are_always_protected {
    # a fresh real backup: chronologically the newest from here on.
    sql node1 { INSERT INTO ws SELECT generate_series(21, 30) }
    sql node1 { SELECT pg_switch_wal() }
    exec node2 bash -c 'sleep 3'
    exec node2 bash -c 'PGPASSWORD=pgaf-repl-pw pg_walserver basebackup --pgdata /tmp/ws --cluster default/0'
    exec node2 bash -c 'cat /tmp/ws/default/0/basebackups/.latest > /tmp/backup_A3.label'

    # a fabricated old backup, cloned from the (still real, still
    # present) A2 backup -- same required WAL segment, still on disk.
    exec node2 bash -c 'cp -a "/tmp/ws/default/0/basebackups/$(cat /tmp/backup_A2.label)" /tmp/ws/default/0/basebackups/basebackup-19970101T000000Z'

    # point ".latest" at that old, non-newest backup by hand -- simulating
    # an operator/process that reset it -- so it is neither the most
    # recent backup by timestamp nor within a strict --keep-count 1
    # window on its own.
    exec node2 bash -c 'printf "%s" "basebackup-19970101T000000Z" > /tmp/ws/default/0/basebackups/.latest'

    exec node2 bash -c 'PGPASSWORD=pgaf-repl-pw pg_walserver archive-cleanup --path /tmp/ws/default/0 --keep-count 1'

    # the backup ".latest" names survives, even though it is neither the
    # newest backup nor, on its own, within the --keep-count 1 window.
    exec node2 bash -c 'test -d /tmp/ws/default/0/basebackups/basebackup-19970101T000000Z || { echo "the .latest backup must never be removed"; ls -la /tmp/ws/default/0/basebackups/; false; }'

    # the real, chronologically-newest backup (A3) also survives -- it is
    # always within any --keep-count >= 1 window on its own.
    exec node2 bash -c 'test -d "/tmp/ws/default/0/basebackups/$(cat /tmp/backup_A3.label)" || { echo "A3 should still be there"; false; }'

    # the middle, real backup (A2) -- neither ".latest" nor the newest --
    # is removed under this aggressive --keep-count 1.
    exec node2 bash -c 'test ! -d "/tmp/ws/default/0/basebackups/$(cat /tmp/backup_A2.label)" || { echo "A2 should have been removed"; false; }'
}

sequence
    test_001_three_backups_and_dry_run_reports_without_deleting
    test_002_refuses_to_run_with_neither_flag
    test_003_bad_keep_age_value_is_rejected
    test_004_keep_count_only_removes_older_backups_leaving_a_restorable_latest
    test_005_more_conservative_wins_between_count_and_age
    test_006_latest_backup_and_its_wal_are_always_protected
