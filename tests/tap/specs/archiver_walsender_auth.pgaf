# pg_walsender authentication, exercised with the stock Postgres client
# tools only -- pg_basebackup and pg_receivewal, both speaking real libpq --
# plus pg_walsender's own fetch-file client (a restore_command).
#
# Access is decided by the archiver's archiver-hba.conf (first matching line
# wins, no match rejects). Its default line trusts every node the monitor
# lists for the route ("monitor" address, kept in the route's archiver-nodes.list
# by its capture service). node2 starts out *unregistered* -- the situation of
# a PITR restore target -- so it is not in that list until test_006
# registers it.
#
#   test_001  a registered node (node1) is trusted: pg_basebackup and
#             pg_receivewal both work with no password
#   test_002  the unregistered host (node2) is rejected by the default file
#   test_003  a scram-sha-256 line for node2 + a stored verifier: right
#             password works for pg_basebackup, pg_receivewal and fetch-file;
#             wrong or missing password is refused
#   test_004  a "reject" line ahead of it wins even with the right password
#   test_005  an IP/prefix line works the same as a hostname line
#   test_006  once node2 registers with the monitor, the default "monitor"
#             line lets it in with no password and no file edit
#
# Predecessor: none.

cluster {
    monitor
    ssl off
    formation {
        node1
        archiver1 archiver
        node2 create and launch deferred
    }
}

setup {
    wait until node1 state is single  timeout 60s
    wait until archiver1 state is archiving  timeout 60s
    wait until sql monitor {
        SELECT status::text FROM pgautofailover.get_latest_basebackup('default', 0, 'live')
    } is { complete }  timeout 120s
}

teardown {
    compose down
}

step test_001_registered_node_is_trusted {
    sql node1 { CREATE TABLE t1(a int); INSERT INTO t1 VALUES (1), (2); }
    let seg = sql node1 { SELECT pg_walfile_name(pg_switch_wal()) }
    wait until sql monitor { SELECT pgautofailover.wal_archived('default', 0, '${seg}') } is { t }  timeout 60s
    exec node1 bash -c 'pg_basebackup -w -d "host=archiver1 port=6543 user=pgautofailover_replicator dbname=default/0" --pgdata /tmp/bb1 -X none --no-manifest && test -f /tmp/bb1/PG_VERSION'
    exec node1 bash -c 'mkdir -p /tmp/rw1 && (timeout 20 pg_receivewal -w -d "host=archiver1 port=6543 user=pgautofailover_replicator dbname=default/0" --directory /tmp/rw1 --no-loop || true) && ls /tmp/rw1 | grep -q .'
}

step test_002_unregistered_host_is_rejected {
    exec node2 bash -c 'if pg_basebackup -w -d "host=archiver1 port=6543 user=pgautofailover_replicator dbname=default/0" --pgdata /tmp/bb2 -X none --no-manifest 2>/tmp/err2; then exit 1; fi; grep -q "no pg_walsender HBA entry" /tmp/err2'
    exec node2 bash -c 'mkdir -p /tmp/rw2; if pg_receivewal -w -d "host=archiver1 port=6543 user=pgautofailover_replicator dbname=default/0" --directory /tmp/rw2 --no-loop 2>/tmp/err2b; then exit 1; fi; grep -q "no pg_walsender HBA entry" /tmp/err2b'
}

step test_003_scram_sha_256 {
    exec archiver1 bash -c 'PGPASSWORD=s3cret pg_walsender scram-secret > /var/lib/postgres/pgaf/archiver-passwd'
    exec archiver1 bash -c 'echo "host default/0 pgautofailover_replicator node2 scram-sha-256" >> /var/lib/postgres/pgaf/archiver-hba.conf'

    # wrong password, and no password at all: both refused
    exec node2 bash -c 'if PGPASSWORD=wrong pg_basebackup -w -d "host=archiver1 port=6543 user=pgautofailover_replicator dbname=default/0" --pgdata /tmp/bb3a -X none --no-manifest 2>/tmp/err3a; then exit 1; fi; grep -q "password authentication failed" /tmp/err3a'
    exec node2 bash -c 'if pg_basebackup -w -d "host=archiver1 port=6543 user=pgautofailover_replicator dbname=default/0" --pgdata /tmp/bb3b -X none --no-manifest 2>/tmp/err3b; then exit 1; fi; grep -q "password" /tmp/err3b'

    # right password: pg_basebackup, pg_receivewal, and the fetch-file client
    exec node2 bash -c 'PGPASSWORD=s3cret pg_basebackup -w -d "host=archiver1 port=6543 user=pgautofailover_replicator dbname=default/0" --pgdata /tmp/bb3c -X none --no-manifest && test -f /tmp/bb3c/PG_VERSION'
    exec node2 bash -c 'mkdir -p /tmp/rw3 && (PGPASSWORD=s3cret timeout 20 pg_receivewal -w -d "host=archiver1 port=6543 user=pgautofailover_replicator dbname=default/0" --directory /tmp/rw3 --no-loop || true) && ls /tmp/rw3 | grep -q .'
    exec node2 bash -c 'if PGPASSWORD=wrong pg_walsender fetch-file --host archiver1 --port 6543 --route default/0 --filename ${seg} --output /tmp/fetched-bad; then exit 1; fi'
    exec node2 bash -c 'PGPASSWORD=s3cret pg_walsender fetch-file --host archiver1 --port 6543 --route default/0 --filename ${seg} --output /tmp/fetched-good && test -s /tmp/fetched-good'
}

step test_004_reject_line_wins {
    exec archiver1 bash -c 'f=/var/lib/postgres/pgaf/archiver-hba.conf; { echo "host all all node2 reject"; cat $f; } > $f.new && mv $f.new $f'
    exec node2 bash -c 'if PGPASSWORD=s3cret pg_basebackup -w -d "host=archiver1 port=6543 user=pgautofailover_replicator dbname=default/0" --pgdata /tmp/bb4 -X none --no-manifest 2>/tmp/err4; then exit 1; fi; grep -q "no pg_walsender HBA entry" /tmp/err4'
    exec archiver1 bash -c 'f=/var/lib/postgres/pgaf/archiver-hba.conf; grep -v "^host all all node2 reject" $f > $f.new && mv $f.new $f'
}

step test_005_cidr_line {
    # replace the hostname line with the whole private range compose uses
    exec archiver1 bash -c 'f=/var/lib/postgres/pgaf/archiver-hba.conf; grep -v " node2 scram-sha-256" $f > $f.new && mv $f.new $f && echo "host default/0 pgautofailover_replicator 172.16.0.0/12 scram-sha-256" >> $f'
    exec node2 bash -c 'PGPASSWORD=s3cret pg_basebackup -w -d "host=archiver1 port=6543 user=pgautofailover_replicator dbname=default/0" --pgdata /tmp/bb5 -X none --no-manifest && test -f /tmp/bb5/PG_VERSION'
    exec node2 bash -c 'if PGPASSWORD=wrong pg_basebackup -w -d "host=archiver1 port=6543 user=pgautofailover_replicator dbname=default/0" --pgdata /tmp/bb5b -X none --no-manifest 2>/tmp/err5; then exit 1; fi; grep -q "password authentication failed" /tmp/err5'
}

step test_006_registered_node_joins_via_monitor_list {
    exec archiver1 bash -c 'f=/var/lib/postgres/pgaf/archiver-hba.conf; grep -v "172.16.0.0/12" $f > $f.new && mv $f.new $f'
    exec node2  pg_autoctl create postgres --pgdata /var/lib/postgres/pgaf --monitor postgresql://autoctl_node@monitor/pg_auto_failover --auth trust --no-ssl --name node2 --hostname node2
    exec node2  bash -c "nohup pg_autoctl run --pgdata /var/lib/postgres/pgaf > /tmp/node2-run.log 2>&1 & echo backgrounded pid $!"
    wait until node2 state is secondary  timeout 120s
    exec archiver1 bash -c 'for i in $(seq 30); do grep -qx node2 /var/lib/postgres/pgaf/default/0/archiver-nodes.list && exit 0; sleep 1; done; exit 1'
    exec node2 bash -c 'pg_basebackup -w -d "host=archiver1 port=6543 user=pgautofailover_replicator dbname=default/0" --pgdata /tmp/bb6 -X none --no-manifest && test -f /tmp/bb6/PG_VERSION'
}

sequence
    test_001_registered_node_is_trusted
    test_002_unregistered_host_is_rejected
    test_003_scram_sha_256
    test_004_reject_line_wins
    test_005_cidr_line
    test_006_registered_node_joins_via_monitor_list
