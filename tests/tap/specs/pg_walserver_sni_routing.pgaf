# TLS SNI-based routing: two named routes, both configured with
# `pg_walserver setup --hostname`, disambiguated by the hostname a real
# client presents during the TLS handshake rather than by `dbname` --
# exactly the case a real physical standby forces (its own walreceiver
# always sends the literal dbname "replication", see auth.c's own comment
# and DESIGN-standalone-archiving.md's "Routing beyond dbname" section).
#
#   test_001  `setup --hostname` on a *second* route creates a self-signed
#             certificate for --pgdata automatically (none existed after
#             the first route alone -- a single named route is still fully
#             disambiguated by dbname, no TLS/SNI needed for it)
#   test_002  a client whose dbname is the useless "replication" (what a
#             real physical standby always sends) is routed to the right
#             route purely by the hostname it connects with -- both ways,
#             proving this is genuine disambiguation, not a coincidence
#   test_003  neither dbname nor the connecting hostname resolves to
#             anything (no route by that name, no wildcard configured):
#             a clean "unknown route" failure, not an accidental match
#   test_004  removing the certificate makes `pg_walserver serve` refuse
#             to start outright: more than one named route without TLS is
#             a hard error, not just `setup`'s own advisory warning

cluster {
    monitor
    ssl off
    formation {
        node1 replication-password "pgaf-repl-pw"
        node2 replication-password "pgaf-repl-pw"
    }
}

setup {
    wait until primary, secondary in group 0  timeout 120s

    # two hostnames resolving to the same pg_walserver, exactly as SNI-based
    # virtual hosting already works for HTTPS -- both routes live on node2,
    # loopback is enough to prove the mechanism
    exec node2 bash -c 'sudo bash -c "echo \"127.0.0.1 routeA.internal\" >> /etc/hosts"'
    exec node2 bash -c 'sudo bash -c "echo \"127.0.0.1 routeB.internal\" >> /etc/hosts"'

    exec node2 bash -c 'mkdir -p /tmp/sni && printf "hostssl all all 127.0.0.1/32 trust\n" > /tmp/sni/archiver-hba.conf'

    # route A: the first route in a brand new pg_walserver.ini -- one named
    # route needs no TLS at all yet, dbname alone is unambiguous
    exec node2 bash -c 'PGPASSWORD=pgaf-repl-pw pg_walserver setup --pgdata /tmp/sni --route routeA --path /tmp/sni/routeA --upstream "host=node1 port=5432 user=pgautofailover_replicator sslmode=disable" --hostname routeA.internal --with-basebackup'
    exec node2 bash -c 'test ! -f /tmp/sni/server.crt'
}

teardown {
    compose down
}

step test_001_second_named_route_creates_certificate {
    # route B: a *second* named route -- this is the moment dbname alone
    # stops being enough, and setup creates a self-signed certificate for
    # --pgdata on its own, with no separate step asked for
    exec node2 bash -c 'PGPASSWORD=pgaf-repl-pw pg_walserver setup --pgdata /tmp/sni --route routeB --path /tmp/sni/routeB --upstream "host=node1 port=5432 user=pgautofailover_replicator sslmode=disable" --hostname routeB.internal --with-basebackup'
    exec node2 bash -c 'test -f /tmp/sni/server.crt && test -f /tmp/sni/server.key'

    # both routes archive from the same upstream (node1), so their real
    # system identifiers are identical -- overwrite routeB's own with a
    # distinguishable fake value directly (bypassing fetch-systemid's own
    # overwrite-safety on purpose, exactly as archiver-systemid is
    # hand-crafted in pg_walserver_standalone.pgaf's own wildcard test), so
    # the checks below prove genuine SNI-based disambiguation rather than
    # two checks that could both pass by coincidence against one shared
    # value if routing were actually broken and resolved both hostnames to
    # the same route
    exec node2 bash -c 'echo "9999999999999999999" > /tmp/sni/routeB/archiver-systemid'

    exec node2 bash -c 'nohup pg_walserver --pgdata /tmp/sni --port 6544 > /tmp/sni-walserver.log 2>&1 & echo started'
    exec node2 bash -c 'for i in $(seq 30); do (echo > /dev/tcp/127.0.0.1/6544) 2>/dev/null && exit 0; sleep 1; done; cat /tmp/sni-walserver.log; exit 1'
}

step test_002_sni_disambiguates_two_routes {
    # both routes are addressed with the exact same, useless dbname
    # ("replication", what a real physical standby's own walreceiver
    # always sends) -- only the hostname each connection presents during
    # the TLS handshake tells them apart
    exec node2 bash -c 'sysidA=$(cat /tmp/sni/routeA/archiver-systemid); out=$(psql "host=routeA.internal port=6544 dbname=replication replication=true sslmode=require" -Atc "IDENTIFY_SYSTEM"); echo "$out" | cut -d"|" -f1 | grep -qx "$sysidA" || { echo "routeA: got $out, want $sysidA"; false; }'
    exec node2 bash -c 'sysidB=$(cat /tmp/sni/routeB/archiver-systemid); out=$(psql "host=routeB.internal port=6544 dbname=replication replication=true sslmode=require" -Atc "IDENTIFY_SYSTEM"); echo "$out" | cut -d"|" -f1 | grep -qx "$sysidB" || { echo "routeB: got $out, want $sysidB"; false; }'
    # the two routes really do have distinct identities -- otherwise the
    # two checks above could both pass by coincidence
    exec node2 bash -c 'test "$(cat /tmp/sni/routeA/archiver-systemid)" != "$(cat /tmp/sni/routeB/archiver-systemid)"'
}

step test_003_unresolved_route_fails_cleanly {
    # plain 127.0.0.1: no SNI hostname at all (fe-secure-openssl.c never
    # sends SNI for a literal IP, RFC 6066), and "replication" matches no
    # named route and there is no "*" wildcard here -- must fail cleanly,
    # never accidentally fall through to either real route
    exec node2 bash -c 'out=$(psql "host=127.0.0.1 port=6544 dbname=replication replication=true sslmode=require" -Atc "IDENTIFY_SYSTEM" 2>&1); echo "$out" | grep -qi "does not exist" || { echo "got: $out"; false; }'
}

step test_004_no_tls_refuses_to_start_with_two_routes {
    exec node2 bash -c 'pkill -x pg_walserver; for i in $(seq 30); do pgrep -x pg_walserver > /dev/null || exit 0; sleep 1; done; exit 1'
    exec node2 bash -c 'mv /tmp/sni/server.crt /tmp/sni/server.crt.bak && mv /tmp/sni/server.key /tmp/sni/server.key.bak'
    exec node2 bash -c 'if pg_walserver --pgdata /tmp/sni --port 6545 2>/tmp/sni-refuse.log; then cat /tmp/sni-refuse.log; false; fi'
    exec node2 bash -c 'grep -qi "named routes but TLS is not" /tmp/sni-refuse.log'
    exec node2 bash -c 'mv /tmp/sni/server.crt.bak /tmp/sni/server.crt && mv /tmp/sni/server.key.bak /tmp/sni/server.key'
}

sequence
    test_001_second_named_route_creates_certificate
    test_002_sni_disambiguates_two_routes
    test_003_unresolved_route_fails_cleanly
    test_004_no_tls_refuses_to_start_with_two_routes
