 init                | demote_timeout
 init                | demoted
 init                | wait_standby
 init                | report_lsn
 join_primary        | single
 join_primary        | wait_primary
 join_primary        | primary
 join_primary        | draining
 join_primary        | demote_timeout
 join_primary        | demoted
 join_secondary      | secondary
 join_secondary      | report_lsn
 maintenance         | demote_timeout
 maintenance         | demoted
