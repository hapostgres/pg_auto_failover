 secondary           | maintenance
 secondary           | wait_maintenance
 secondary           | report_lsn
 single              | wait_primary
 single              | demote_timeout
 single              | demoted
 stop_replication    | single
 stop_replication    | wait_primary
 stop_replication    | demote_timeout
