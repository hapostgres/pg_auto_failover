 prepare_maintenance | maintenance
 prepare_maintenance | report_lsn
 prepare_promotion   | single
 prepare_promotion   | wait_primary
 prepare_promotion   | demote_timeout
 prepare_promotion   | demoted
 prepare_promotion   | stop_replication
 prepare_promotion   | report_lsn
 primary             | single
 primary             | wait_primary
 primary             | draining
 primary             | demote_timeout
 primary             | demoted
 primary             | maintenance
 primary             | join_primary
 primary             | apply_settings
 primary             | prepare_maintenance
 report_lsn          | single
 report_lsn          | demote_timeout
 report_lsn          | demoted
 report_lsn          | secondary
 report_lsn          | prepare_promotion
 report_lsn          | fast_forward
 report_lsn          | join_secondary
 secondary           | single
 secondary           | demote_timeout
 secondary           | demoted
 secondary           | catchingup
 secondary           | prepare_promotion
